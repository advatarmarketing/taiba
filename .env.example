# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill it in. `.env` is never committed.
# The same values go into Vercel → Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# The password for "Web dev edit" mode at the bottom of the site.
# Pick something long. Anyone with this can change the site's words.
ADMIN_PASSWORD=

# A long random string used to sign the login cookie, so a session cannot be
# faked. Generate one by running this in a terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# THE DATABASE. Do NOT add these two to Vercel by hand.
#
# The "Upstash for Redis" integration on the Vercel Marketplace sets them for
# you when you connect a database to the project. Adding them yourself — or
# pasting this file into Vercel wholesale — creates two EMPTY variables that
# look connected and are not, which is a genuinely horrible afternoon.
#
# Locally they stay blank on purpose: without them the site uses a throwaway
# JSON file at .data/store.json, which is what you want for testing.
#
# Check /api/health on any deployment to see which the site is actually using.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# The address the live site is served from, with no trailing slash:
#   SITE_URL=https://taibaislamiccentre.org
# Used to write absolute addresses into sitemap.xml. Leave it blank and the
# sitemap uses whatever host the request arrived on, which is right locally and
# on a Vercel preview — so this only really matters in production.
SITE_URL=

# Set to "1" to allow POST /api/seed to load data/seed.json into the database.
# Leave blank in production.
ALLOW_SEED=

# Belt-and-braces guard: keeps `vercel dev` on the local file store even if the
# Vercel CLI pulls the live database credentials down. Local .env only —
# never set this on Vercel.
TIC_LOCAL_STORE=1
